<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package: gives the installed Arc (an ordinary exe, not repackaged) a package identity,
  which the Windows 11 Explorer context menu requires. Its only job is the menu: the COM server
  arc_shell.dll (app/shellext) next to arc.exe. Built and signed by app/scripts/build-shell.ps1;
  registered by the installer with the install folder as the external location.
  Publisher must equal the subject of the signing certificate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity Name="Arc.Archiver" Publisher="CN=Arc Archiver" Version="1.0.0.0" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>Arc</DisplayName>
    <PublisherDisplayName>Arc</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="Arc" Executable="arc.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="Arc"
        Description="Arc archiver"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Arc" Clsid="37B70A45-F2C2-4F46-8A59-3EE158D32A3D" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Arc" Clsid="37B70A45-F2C2-4F46-8A59-3EE158D32A3D" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <!-- packagedClassicApp: the handler runs as a packaged app (as in PowerToys' sparse packages);
             inherited win32App leaves it out of the new menu -->
        <com:Extension Category="windows.comServer" uap10:RuntimeBehavior="packagedClassicApp">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Arc context menu">
              <com:Class Id="37B70A45-F2C2-4F46-8A59-3EE158D32A3D" Path="arc_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
